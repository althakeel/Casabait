# =============================================================================
# Casa Bait — SMTP credentials (loaded by email.json via ${VAR} placeholders)
# Copy to .env.local for local dev. NEVER commit real credentials.
# On Render: add these in Dashboard → Environment (same variable names).
# =============================================================================

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP login (keep secret — referenced from email.json)
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Sender and team inbox (referenced from email.json)
SMTP_FROM_EMAIL=inquiries@casabait.ae
CONTACT_TEAM_EMAIL=info@casabait.ae

# Public site URL — used for logo links in email templates
SITE_URL=https://www.casabait.ae

# Optional: rate limiting
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
